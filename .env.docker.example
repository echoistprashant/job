# Docker Compose Production Environment Variables Template

# Application
APP_NAME="AI Job Application Agent"
APP_ENV=production
DEBUG=False

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_db_password_here
POSTGRES_DB=ai_job_agent

# Security & Data Encryption (Fernet 32-byte secret)
SECRET_KEY=generate_a_strong_random_secret_key_for_production
APP_SECRET_KEY=generate_a_strong_random_secret_key_for_production

# CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost"

# LLM Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Automation Safety Defaults
AUTO_APPLY_ENABLED=false
MINIMUM_MATCH_SCORE=75
