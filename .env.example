# Application Configuration
APP_NAME="AI Job Application Agent"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Security & CORS
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_job_agent
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_job_agent

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Auto-Apply Controls
AUTO_APPLY_ENABLED=false
MINIMUM_MATCH_SCORE=75
